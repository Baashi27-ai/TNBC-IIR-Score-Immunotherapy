list_all_files <- function(path) {
# List all files with details
all_files <- list.files(path, full.names = TRUE, recursive = TRUE)
# Get file info
file_details <- file.info(all_files)
# Create a comprehensive data frame
result <- data.frame(
File_Path = all_files,
File_Name = basename(all_files),
Directory = dirname(all_files),
Size_Bytes = file_details$size,
Size_KB = round(file_details$size / 1024, 2),
Size_MB = round(file_details$size / (1024^2), 2),
Modified_Time = file_details$mtime,
Is_Directory = file_details$isdir,
Extension = tools::file_ext(all_files)
)
# Filter out directories if you only want files
result <- result[!result$Is_Directory, ]
return(result)
}

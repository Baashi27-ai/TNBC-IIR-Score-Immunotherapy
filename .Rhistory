library(survival)
library(boot)
# Load escape-adjusted ICB data
esc_data <- read.table("Phase_XI_Escape_Adjusted_ICB/results/escape_adjusted/escape_adjusted_ICB_TNBC_like_TCGA.tsv",
header=TRUE, sep="\t", check.names=FALSE)
cat("\n=== ESCAPE-ADJUSTED ICB SUMMARY ===\n")
cat("Total patients:", nrow(esc_data), "\n")
cat("Events (deaths):", sum(esc_data$os_event, na.rm=TRUE), "\n")
# Cox model
cox_model <- coxph(Surv(os_time, os_event) ~ escape_adjusted_ICB_group, data=esc_data)
cat("\nCox model results:\n")
print(summary(cox_model))
# Extract HR for High vs Intermediate
hr_high <- exp(coef(cox_model)[1])
ci_high <- exp(confint(cox_model)[1,])
cat("\nHR for High_ICB_candidate vs Intermediate:")
cat("\n  HR =", round(hr_high, 2))
cat("\n  95% CI =", round(ci_high[1], 2), "-", round(ci_high[2], 2))
cat("\n  p =", round(summary(cox_model)$coefficients[1,5], 4))
# Check proportional hazards assumption
cox_zph <- cox.zph(cox_model)
cat("\n\nProportional hazards test:")
cat("\n  p =", round(cox_zph$table[1,3], 4))
if(cox_zph$table[1,3] < 0.05) {
cat("\n  WARNING: PH assumption violated!")
}
# BOOTSTRAP VALIDATION
set.seed(42)
boot_hr <- function(data, indices) {
d <- data[indices, ]
m <- coxph(Surv(os_time, os_event) ~ escape_adjusted_ICB_group, data=d)
# Return HR for High vs Intermediate
return(exp(coef(m)[1]))
}
# Bootstrap with 1000 iterations
cat("\n\nRunning bootstrap validation (1000 iterations)...\n")
boot_results <- boot(esc_data, boot_hr, R=1000)
boot_ci <- boot.ci(boot_results, type="perc")
cat("\nBootstrap results:")
cat("\n  Original HR:", round(hr_high, 2))
cat("\n  Bootstrap mean HR:", round(mean(boot_results$t), 2))
cat("\n  95% percentile CI:", round(boot_ci$percent[4], 2), "-", round(boot_ci$percent[5], 2))
# What % of bootstraps give HR < 1?
prop_hr_less_than_1 <- mean(boot_results$t < 1)
cat("\n  % of bootstraps with HR < 1:", round(prop_hr_less_than_1 * 100, 1), "%")
# Histogram of bootstrap HRs
hist(boot_results$t, breaks=50, main="Bootstrap HR Distribution",
xlab="HR (High vs Intermediate)", col="steelblue", border="white")
abline(v=1, col="red", lwd=2, lty=2)
abline(v=hr_high, col="blue", lwd=2)
abline(v=quantile(boot_results$t, c(0.025, 0.975)), col="green", lty=2)
legend("topright", legend=c("HR=1 (null)", "Original HR", "95% CI"),
col=c("red", "blue", "green"), lty=c(2,1,2), lwd=2)

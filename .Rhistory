# Let's see EXACTLY what's in the xCell file
xcell_raw <- read.csv("Phase_I_Immune_Deconv/results/immune_scores/xcell_scores_TNBC_like_TCGA.csv",
check.names=FALSE)
# Get all column names (sample IDs)
all_samples <- colnames(xcell_raw)[-1]
# Find duplicates
dup_patterns <- c("\\.1$", "\\.2$", "\\.3$")
dup_samples <- all_samples[grepl(paste(dup_patterns, collapse="|"), all_samples)]
cat("=== DUPLICATE SAMPLE ANALYSIS ===\n")
cat("Total samples in xCell:", length(all_samples), "\n")
cat("Samples with .1/.2 suffix:", length(dup_samples), "\n")
# Show the duplicates
for(s in unique(gsub("\\..*$", "", dup_samples))) {
matches <- all_samples[grepl(paste0("^", s), all_samples)]
cat(s, "appears", length(matches), "times:", paste(matches, collapse=", "), "\n")
}
# What about the original samples that were duplicated?
original_samples <- all_samples[!grepl(paste(dup_patterns, collapse="|"), all_samples)]
cat("\nUnique samples (no duplicates):", length(original_samples), "\n")
# Are the duplicates identical in terms of xCell scores?
# Let's check one duplicate pair
if(length(dup_samples) > 0) {
sample1 <- dup_samples[1]
sample2 <- gsub("\\.1$", "", sample1)
if(sample2 %in% colnames(xcell_raw)) {
# Compare scores
scores1 <- xcell_raw[, sample1]
scores2 <- xcell_raw[, sample2]
cor_val <- cor(scores1, scores2, use="complete.obs")
cat("\nCorrelation between", sample1, "and", sample2, ":", round(cor_val, 4))
if(cor_val > 0.99) {
cat(" → IDENTICAL! These are true duplicates!\n")
} else {
cat(" → Different! These might be different samples with same base ID.\n")
}
}
}

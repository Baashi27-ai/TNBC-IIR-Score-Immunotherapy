# Let's track samples across ALL phases
setwd("D:/Baashi/TNBC_project/Immune_Spatial_Immunotherapy")
# Function to get sample IDs from a file
get_sample_ids <- function(file_path, id_col="submitter_id") {
if(!file.exists(file_path)) return(NULL)
# Try different separators
data <- tryCatch({
read.table(file_path, header=TRUE, sep="\t", check.names=FALSE)
}, error=function(e) {
tryCatch({
read.csv(file_path, check.names=FALSE)
}, error=function(e) {
NULL
})
})
if(is.null(data)) return(NULL)
if(id_col %in% colnames(data)) {
return(as.character(data[, id_col]))
} else if("submitter_id" %in% colnames(data)) {
return(as.character(data$submitter_id))
} else {
# Try first column
return(as.character(data[,1]))
}
}
# Track samples through phases
phases <- list(
Phase_I_xCell = "Phase_I_Immune_Deconv/results/immune_scores/xcell_scores_TNBC_like_TCGA.csv",
Phase_I_OS = "Phase_I_Immune_Deconv/results/immune_scores/immune_hot_cold_TNBC_like_TCGA_OS.tsv",
Phase_II_Subtypes = "Phase_II_Immune_Subtypes/results/immune_subtypes/immune_subtypes_TNBC_like_TCGA_core.tsv",
Phase_III_PD1 = "Phase_III_Immunotherapy_Prediction/results/immunotherapy/PD1_PDL1_signature_TNBC_like_TCGA.tsv",
Phase_IV_Spatial = "Phase_IV_Spatial_Metrics/results/spatial_metrics/spatial_metrics_with_clin_TNBC_like_TCGA.tsv",
Phase_V_DPI = "Phase_V_Drug_Penetration/results/drug_penetration/DPI_TNBC_like_TCGA.tsv",
Phase_VI_TMB = "Phase_VI_Mutations/results/mutations/TMB_TNBC_like_TCGA_from_MAF.tsv",
Phase_VII_Signatures = "Phase_VII_Mutational_Signatures/results/signatures/signature_scores_TNBC_like_TCGA.tsv",
Phase_VIII_IIR = "Phase_VIII_Immunotherapy_Integration/results/integration/IIR_table_TNBC_like_TCGA.tsv",
Phase_X_HLA = "Phase_X_HLA_ImmuneEscape/results/hla/HLA_escape_TNBC_like_TCGA.tsv",
Phase_XI_Escape = "Phase_XI_Escape_Adjusted_ICB/results/escape_adjusted/escape_adjusted_ICB_TNBC_like_TCGA.tsv"
)
sample_counts <- data.frame()
for(name in names(phases)) {
ids <- get_sample_ids(phases[[name]])
if(!is.null(ids)) {
sample_counts <- rbind(sample_counts,
data.frame(Phase=name, N=length(ids)))
}
}
print(sample_counts)
# Show which samples are lost at each step
all_phase1_ids <- get_sample_ids(phases$Phase_I_xCell)
all_phase8_ids <- get_sample_ids(phases$Phase_VIII_IIR)
if(!is.null(all_phase1_ids) && !is.null(all_phase8_ids)) {
# Clean duplicate suffixes for fair comparison
clean_ids <- function(ids) {
return(gsub("\\.[0-9]+$", "", ids))
}
p1_clean <- clean_ids(all_phase1_ids)
p8_clean <- clean_ids(all_phase8_ids)
# Which Phase I samples are missing in Phase VIII?
missing_in_p8 <- setdiff(p1_clean, p8_clean)
cat("\n=== SAMPLES LOST FROM PHASE I TO VIII ===\n")
cat("Phase I samples:", length(unique(p1_clean)), "\n")
cat("Phase VIII samples:", length(unique(p8_clean)), "\n")
cat("Lost samples:", length(missing_in_p8), "\n")
if(length(missing_in_p8) > 0) {
print(head(missing_in_p8, 20))
}
}

# Only include components that exist
components <- components[components %in% colnames(iir_data)]
if(length(components) > 1) {
cor_matrix <- cor(iir_data[, components], use="complete.obs")
cat("\nCorrelation matrix of IIR components:\n")
print(round(cor_matrix, 2))
# Check if any components are too highly correlated (>0.7)
high_cor <- which(abs(cor_matrix) > 0.7 & cor_matrix < 1, arr.ind=TRUE)
if(nrow(high_cor) > 0) {
cat("\nWARNING: Highly correlated components detected!\n")
for(i in 1:nrow(high_cor)) {
cat("  ", components[high_cor[i,1]], "&", components[high_cor[i,2]],
":", round(cor_matrix[high_cor[i,1], high_cor[i,2]], 2), "\n")
}
}
}
